# Copier ce fichier en .env (même dossier) puis renseigner les valeurs.
# Ne jamais versionner le fichier .env.

# Application
APP_ENV=development
DEBUG=true
SECRET_KEY=change_this_in_production

# Base de données (PostgreSQL)
POSTGRES_USER=quantai
POSTGRES_PASSWORD=quantai_secret
POSTGRES_DB=quantai
DATABASE_URL=postgresql+asyncpg://quantai:quantai_secret@db:5432/quantai
DATABASE_URL_SYNC=postgresql://quantai:quantai_secret@db:5432/quantai

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# CORS
CORS_ORIGINS=http://localhost:3000

# Alpaca Paper Trading (https://app.alpaca.markets → Paper Trading → API Keys)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets/v2

# Assistant IA (Groq, https://console.groq.com)
GROQ_API_KEY=
